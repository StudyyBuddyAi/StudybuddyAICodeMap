# ── Client (compiled into the bundle at build time — VITE_*) ────────────────
VITE_SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_staging_anon_key_here

# ── Edge functions (server-side only — never expose to the browser) ─────────
# Consumed by supabase/functions/{medical-notes,get-citations,rag-generate}. These run on
# the Supabase edge runtime, so they read real env vars, NOT the VITE_* client
# variables. Vercel uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY to deploy
# functions, but the functions read their own runtime env on the Supabase side.
SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# OpenRouter key used by medical-notes & rag-generate to route embeddings/completions.
OPENROUTER_API_KEY=your_openrouter_key_here
# Optional NCBI E-utilities API key for get-citations (higher rate limits).
NCBI_API_KEY=your_ncbi_api_key_here

# Optional n8n RAG Webhook URL override (if calling n8n directly instead of Supabase Edge Function)
# VITE_N8N_RAG_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/rag-generate

# Optional: canonical app origin, used to build redirect links in auth emails
# and OAuth callbacks (password reset, Google sign-in). Falls back to
# window.location.origin when unset, which is correct for local dev and
# preview deploys but should be pinned in production.
# VITE_SITE_URL=https://www.studyybuddyai.com

# Google OAuth (Supabase CLI reads these for `supabase config push`/`supabase start`).
# Create credentials in Google Cloud Console; redirect URI is
# https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_oauth_client_secret_here

# ── Corti Models (QBank on-demand generation) ──────────────────────────────
# Independent of OpenRouter: these come from the Corti Console and are used
# ONLY by supabase/functions/qbank-generate.
#
# Corti authenticates with OAuth2 client_credentials against Keycloak, NOT a
# static bearer key. The console gives you client_id, client_secret, a tenant
# (usually "base") and a region; _shared/corti.ts exchanges them for an access
# token that lives 300 seconds and caches it. Sending the secret directly as a
# bearer token returns an empty HTTP 400 from the Models gateway — the same
# response a random string gets — so if you ever see that, this is why.
#
# Set as Supabase edge secrets, never in the client bundle:
#   supabase secrets set CORTI_CLIENT_ID=... CORTI_CLIENT_SECRET=...
#   supabase secrets set CORTI_TENANT=base CORTI_REGION=eu CORTI_MODEL=corti-s1-instant
CORTI_CLIENT_ID=your_corti_client_id_here
CORTI_CLIENT_SECRET=your_corti_client_secret_here
# Keycloak realm for your project. The Corti Console calls this the tenant.
CORTI_TENANT=base
# Data residency for the request. One of: eu | us. Defaults to eu.
CORTI_REGION=eu
# Writer model. Leave this as corti-s1-instant. The reasoning variant
# (corti-s1) does not work for this prompt: measured against a five-item batch
# it spent its entire 32,768-token output budget on reasoning, emitted zero
# content, and terminated after 381 seconds. Its only effort levels are "high"
# and "max", so there is no dial to turn it down. See _shared/corti.ts.
CORTI_MODEL=corti-s1-instant
