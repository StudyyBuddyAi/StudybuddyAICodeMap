# ── Client (compiled into the bundle at build time — VITE_*) ────────────────
VITE_SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_staging_anon_key_here

# ── Edge functions (server-side only — never expose to the browser) ─────────
# Consumed by supabase/functions/{medical-notes,get-citations}. These run on
# the Supabase edge runtime, so they read real env vars, NOT the VITE_* client
# variables. Vercel uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY to deploy
# functions, but the functions read their own runtime env on the Supabase side.
SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# OpenRouter key used by medical-notes to route to gpt-oss-20b / claude-haiku.
OPENROUTER_API_KEY=your_openrouter_key_here
# Optional NCBI E-utilities API key for get-citations (higher rate limits).
NCBI_API_KEY=your_ncbi_api_key_here
