VITE_SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_staging_anon_key_here

# Auth
# Bundled into the client. Used for the password-reset redirect; must also be
# present in the Supabase Redirect URLs allowlist or reset links will fail.
VITE_SITE_URL=https://www.studyybuddyai.com

# Supabase CLI config — read by supabase/config.toml via env().
# Server-side only. NEVER give these a VITE_ prefix: anything VITE_-prefixed is
# inlined into the browser bundle, which would publish the SMTP credentials.
SUPABASE_AUTH_SITE_URL=https://www.studyybuddyai.com
MAILTRAP_SMTP_USER=api
MAILTRAP_SMTP_PASS=your_mailtrap_api_token_here
